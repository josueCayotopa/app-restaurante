<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS · sitio api.chicharroneriacade.com
  Carpeta del sitio: ...\app-restaurante\server\iis   (solo contiene este archivo)
  IIS no ejecuta Node: la API corre con "npm start" en ...\server (puerto 3001) e IIS le
  reenvía TODO lo que llega a este dominio (incluye fotos /uploads y el tiempo real /socket.io).

  Requisitos en el servidor (una sola vez):
    1. Módulo "URL Rewrite".
    2. "Application Request Routing" (ARR) con el proxy activado:
       IIS Manager → servidor → Application Request Routing Cache → Server Proxy Settings → Enable proxy.
    3. Característica de Windows "Protocolo WebSocket" (tiempo real de cocina/bar).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Validación del certificado HTTPS (Let's Encrypt / win-acme): se sirve desde esta carpeta, no se reenvía -->
        <rule name="Certificado SSL" stopProcessing="true">
          <match url="^\.well-known/" />
          <action type="None" />
        </rule>
        <rule name="CADE API → Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Fotos de productos de hasta 5 MB (el límite de la API) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
